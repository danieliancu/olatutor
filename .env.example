# Local development only. Copy to .env (git-ignored) and replace both secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
POSTGRES_PASSWORD=replace-with-a-local-password

# Host port for the web app. Postgres is not published to the host.
WEB_PORT=8000

# Address the web app binds to on the host. The prototype has NO authentication:
# change to 0.0.0.0 only on a trusted network, to test on a real tablet.
WEB_BIND=127.0.0.1

# Extra Host headers Django accepts (comma separated), e.g. your PC's LAN IP.
DJANGO_EXTRA_ALLOWED_HOSTS=
